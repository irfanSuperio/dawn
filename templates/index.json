        "custom_liquid": "<section class=\"kt-cta\"><div class=\"kt-cta__bg\"></div><div class=\"page-width kt-cta__inner\"><div class=\"kt-cta__text\"><div class=\"kt-label\">Limited Drop</div><h2 class=\"kt-cta__title\">KiTech AI Pro <span class=\"kt-gradient-text\">Series X</span></h2><p>The most powerful consumer AI device ever built. 200 TOPS. 7-day battery. Zero compromise. Pre-order now — shipping Q3 2026.</p><div class=\"kt-cta__actions\"><a href=\"/collections/all\" class=\"kt-btn kt-btn--primary\">Pre-Order Now →</a><a href=\"/collections/all\" class=\"kt-btn kt-btn--ghost\">Learn More</a></div></div><div class=\"kt-cta__countdown\"><div class=\"kt-countdown\"><div class=\"kt-countdown__unit\"><strong id=\"kt-days\">12</strong><span>Days</span></div><div class=\"kt-countdown__sep\">:</div><div class=\"kt-countdown__unit\"><strong id=\"kt-hours\">08</strong><span>Hours</span></div><div class=\"kt-countdown__sep\">:</div><div class=\"kt-countdown__unit\"><strong id=\"kt-mins\">43</strong><span>Mins</span></div><div class=\"kt-countdown__sep\">:</div><div class=\"kt-countdown__unit\"><strong id=\"kt-secs\">17</strong><span>Secs</span></div></div></div></div></section><script>!function(){function u(e){return String(e).padStart(2,'0')}var d=new Date();d.setDate(d.getDate()+12);d.setHours(d.getHours()+8,d.getMinutes()+43,17);function t(){var n=Math.max(0,d-Date.now()),s=Math.floor(n/864e5),h=Math.floor(n%864e5/36e5),m=Math.floor(n%36e5/6e4),se=Math.floor(n%6e4/1e3);document.getElementById('kt-days')&&(document.getElementById('kt-days').textContent=u(s),document.getElementById('kt-hours').textContent=u(h),document.getElementById('kt-mins').textContent=u(m),document.getElementById('kt-secs').textContent=u(se))}t();setInterval(t,1000)}();</script>",
