{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "caption": {
          "type": "text",
          "settings": {
            "text": "{{ product.metafields.descriptors.subtitle.value }}",
            "text_style": "subtitle"
          }
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": false
          }
        },
        "description": {
          "type": "description"
        },
        "collapsible-row-0": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "In the Box",
            "icon": "gift",
            "content": "<p>KiTech Pro device · 100W MagCharge Cable · Charging Brick · SIM Tool · AirCase · Polishing Cloth<\/p>",
            "page": ""
          }
        },
        "collapsible-row-1": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Shipping & Returns",
            "icon": "truck",
            "content": "<p>Free express worldwide shipping. Delivered in 1-3 business days. 30-day hassle-free returns — no questions asked.<\/p>",
            "page": ""
          }
        },
        "collapsible-row-2": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Warranty",
            "icon": "chat_bubble",
            "content": "<p>3-year comprehensive warranty covering manufacturing defects and battery degradation. Optional KiTech Care+ for accidental damage protection.<\/p>",
            "page": ""
          }
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "caption",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "description",
        "collapsible-row-0",
        "collapsible-row-1",
        "collapsible-row-2",
        "share"
      ],
      "settings": {
        "enable_sticky_info": false,
        "gallery_layout": "stacked",
        "media_size": "large",
        "constrain_to_viewport": true,
        "mobile_thumbnails": "show",
        "hide_variants": false,
        "enable_video_looping": true,
        "color_scheme": "scheme-1",
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "pdp-features": {
      "type": "kitech-pdp-features",
      "settings": {}
    },
    "pdp-specs": {
      "type": "kitech-pdp-specs",
      "settings": {}
    },
    "pdp-comparison": {
      "type": "kitech-pdp-comparison",
      "settings": {}
    },
    "pdp-reviews": {
      "type": "kitech-pdp-reviews",
      "settings": {}
    },
    "pdp-faq": {
      "type": "kitech-pdp-faq",
      "settings": {}
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "Complete Your Setup",
        "heading_size": "h2",
        "columns_desktop": 4,
        "color_scheme": "scheme-2",
        "image_ratio": "square",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 36
      }
    }
  },
  "order": [
    "main",
    "pdp-features",
    "pdp-specs",
    "pdp-comparison",
    "pdp-reviews",
    "pdp-faq",
    "related-products"
  ]
}
